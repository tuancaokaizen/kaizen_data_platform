# Tailscale — chạy script bootstrap/dashboard từ laptop, không cần kubectl port-forward
# Copy: cp config/.env.tailscale.example config/.env

# Superset — NodePort 32288 → pod 8888 (svc apache-superset, ns apps)
# Tailscale: http://100.104.250.97:32288  hoặc http://100.104.250.97 nếu có Ingress :80
SUPERSET_HOST=http://100.104.250.97:32288
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin

# In-cluster URL (nếu script chạy trong K3s pod)
# SUPERSET_HOST=http://apache-superset.apps.svc.cluster.local:8888

# ClickHouse URI lưu TRONG Superset — pod Superset query qua DNS nội bộ K3s
# URI này Superset pod dùng khi render chart (không phải laptop)
CLICKHOUSE_SUPERSET_HOST=clickhouse-service.databases.svc.cluster.local
# native=9000 (in-cluster, giống Go backend) | http=8123
CLICKHOUSE_SUPERSET_DRIVER=connect
CLICKHOUSE_SUPERSET_PORT=8123

CLICKHOUSE_DATABASE=report
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=kaizen123

# MinIO — auto port-forward localhost:31900 → svc/minio:9000 (giống deploy_batch.sh)
MINIO_ENDPOINT=http://localhost:31900
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=kaizen123
MINIO_BUCKET=superset
MINIO_ASSETS_PREFIX=assets/
