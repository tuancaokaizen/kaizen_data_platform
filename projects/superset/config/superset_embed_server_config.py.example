# Paste into superset_config.py on the Superset server, then restart Superset pods.
# Dán vào superset_config.py trên server Superset, rồi restart pod Superset.
#
# Without EMBEDDED_SUPERSET=True, /embedded/<uuid> returns HTTP 404 even when
# guest_token API works and dashboards have embedded UUID configured.
#
# Critical for cross-origin embed (Report UI :31090 → Superset :32288):
# Talisman defaults to X-Frame-Options: SAMEORIGIN which blocks the iframe.
# Must set frame_options=None and CSP frame-ancestors to the Report UI origin.

import os

FEATURE_FLAGS = {
    **(FEATURE_FLAGS if "FEATURE_FLAGS" in globals() else {}),
    "EMBEDDED_SUPERSET": True,
}

GUEST_TOKEN_JWT_SECRET = os.environ.get(
    "GUEST_TOKEN_JWT_SECRET", "CHANGE_ME_use_long_random_secret"
)
GUEST_ROLE_NAME = "Gamma"
GUEST_TOKEN_JWT_AUDIENCE = os.environ.get("GUEST_TOKEN_JWT_AUDIENCE", "kaizen-embedded")

TALISMAN_ENABLED = True
TALISMAN_CONFIG = {
    "force_https": False,
    "session_cookie_secure": False,
    "frame_options": None,
    "content_security_policy": {
        "base-uri": ["'self'"],
        "default-src": ["'self'"],
        "img-src": ["'self'", "blob:", "data:"],
        "worker-src": ["'self'", "blob:"],
        "connect-src": ["'self'"],
        "object-src": "'none'",
        "style-src": ["'self'", "'unsafe-inline'"],
        "script-src": ["'self'", "'strict-dynamic'"],
        "frame-ancestors": [
            "'self'",
            "http://192.168.100.172:31090",
            "http://localhost:8092",
            "http://127.0.0.1:8092",
        ],
    },
    "content_security_policy_nonce_in": ["script-src"],
}
