# Superset — svc apache-superset (ns apps), NodePort 32288 → 8888
SUPERSET_HOST=http://localhost:32288
# Tailscale: SUPERSET_HOST=http://100.104.250.97:32288
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin

# ClickHouse URI registered inside Superset (must be reachable from Superset pod)
CLICKHOUSE_SUPERSET_HOST=clickhouse-service.databases.svc.cluster.local
CLICKHOUSE_SUPERSET_DRIVER=connect
CLICKHOUSE_SUPERSET_PORT=8123

# Fallback when CLICKHOUSE_SUPERSET_* unset
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=report
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=kaizen123

# MinIO — dashboard assets (GitOps); port 31900 = auto port-forward like batch/stream
MINIO_ENDPOINT=http://localhost:31900
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=kaizen123
MINIO_BUCKET=superset
MINIO_ASSETS_PREFIX=assets/
