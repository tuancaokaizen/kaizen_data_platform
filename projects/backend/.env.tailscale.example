# Tailscale-only — no kubectl, no manual port-forward
# Chỉ cần Tailscale: copy file này → .env và sửa CLICKHOUSE_HOST nếu cần
#
# Admin (1 lần): Tailscale trên máy K3s + ClickHouse NodePort 30900
#   tailscale ip -4
#   kubectl get svc -n databases clickhouse-shared

SKIP_K8S_FORWARD=1

# K3s master Tailscale IP (clickhouse-shared NodePort native)
CLICKHOUSE_HOST=100.104.250.97
CLICKHOUSE_PORT=30900

API_PORT=8090
CLICKHOUSE_DATABASE=report
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=kaizen123
QUERY_TIMEOUT_SECONDS=15
