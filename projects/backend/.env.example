API_PORT=8090

# --- Default: run_local.sh auto port-forwards K3s → localhost ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000

# --- Colleague: Tailscale only (no kubectl) — copy .env.tailscale.example ---
# cp .env.tailscale.example .env

# --- Or LAN NodePort without Tailscale ---
# SKIP_K8S_FORWARD=1
# CLICKHOUSE_HOST=192.168.1.100
# CLICKHOUSE_PORT=30900

CLICKHOUSE_DATABASE=report
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=kaizen123

QUERY_TIMEOUT_SECONDS=15

# Superset embedded BI — forward via run_local.sh (apps/apache-superset → :32288)
SUPERSET_HOST=http://localhost:32288
# Public URL for browser iframe (dev: Vite proxy) / URL công khai cho iframe trình duyệt
SUPERSET_EMBED_DOMAIN=http://localhost:8092
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin
